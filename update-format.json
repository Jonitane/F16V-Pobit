{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F16V-PoBit update channel",
  "type": "object",
  "required": ["schema", "items"],
  "properties": {
    "schema": {"const": "f16v.updates/1"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "version", "url"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^(software|f16v_base|dlc\\.[a-z][a-z0-9_-]*)$"},
          "kind": {"enum": ["software", "component"]},
          "name": {"type": "string"},
          "version": {"type": "string", "pattern": "^(F16V_Test_)?[0-9]+(\\.[0-9]+)*$"},
          "url": {"type": "string", "format": "uri"},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "notes": {"type": "string"},
          "min_installer": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
        }
      }
    }
  }
}
